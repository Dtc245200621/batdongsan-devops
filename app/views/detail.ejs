<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8"><title><%= l.title %></title>
<style>body{font-family:Arial,sans-serif;max-width:800px;margin:20px auto;padding:0 12px}
input,textarea,button{padding:6px;margin:4px 0;display:block;width:100%;box-sizing:border-box}
.price{color:#c0392b;font-weight:bold;font-size:1.3em}.ok{color:green}</style></head><body>
<a href="/">← Về trang chủ</a>
<h1><%= l.title %></h1>
<div class="price"><%= Number(l.price).toLocaleString('vi-VN') %> đ</div>
<p><%= l.type %> · <%= l.city %> · <%= l.address %> · <%= l.area %> m²</p>
<p><%= l.description %></p>
<p>Liên hệ: <b><%= l.owner_name %></b> - <%= l.owner_phone %></p>
<hr>
<h3>Gửi yêu cầu liên hệ</h3>
<% if (sent) { %><p class="ok">Đã gửi yêu cầu thành công!</p><% } %>
<form method="post" action="/listings/<%= l.id %>/contact">
  <input name="name" placeholder="Họ tên" required>
  <input name="phone" placeholder="Số điện thoại" required>
  <textarea name="message" placeholder="Nội dung"></textarea>
  <button>Gửi</button>
</form>
</body></html>
