<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8"><title>Đăng tin</title>
<style>body{font-family:Arial,sans-serif;max-width:600px;margin:20px auto;padding:0 12px}
input,select,textarea,button{padding:6px;margin:4px 0;display:block;width:100%;box-sizing:border-box}</style></head><body>
<a href="/">← Về trang chủ</a>
<h1>Đăng tin bất động sản</h1>
<form method="post" action="/post">
  <input name="title" placeholder="Tiêu đề" required>
  <select name="type"><option>Nhà</option><option>Đất</option><option>Căn hộ</option></select>
  <input name="city" placeholder="Thành phố" required>
  <input name="address" placeholder="Địa chỉ" required>
  <input name="price" type="number" placeholder="Giá (VNĐ)" required>
  <input name="area" type="number" step="0.01" placeholder="Diện tích (m²)" required>
  <textarea name="description" placeholder="Mô tả"></textarea>
  <input name="owner_name" placeholder="Tên người đăng" required>
  <input name="owner_phone" placeholder="Số điện thoại" required>
  <button>Đăng tin</button>
</form>
</body></html>
